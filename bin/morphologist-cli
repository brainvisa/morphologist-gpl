#!/usr/bin/env python
import argparse
import pathlib
import sys
import textwrap
import os
import os.path as osp
import subprocess
from capsul.api import capsul_engine
from capsul.datasel import data_selector
import morphologist.info
import capsul.info as cinfo


morphologist_version = morphologist.info.__version__.rsplit(".", 1)[0]


def morphologist(
    mri, output_dir, input_dir=None, subjects_atts=[], pipeline="morphologist",
    variant=morphologist_version, capsul_args=[], morpho_args=[],
    dry_run=False, input_fom="morpholgist-bids-2.0"
):
    """Process T1 MR images with BrainVISA/Morphologist pipeline
    and put the result in an output directory using the following
    BIDS organization:

    \b
    {OUTPUT_DIR}/derivatives/{pipeline}-{variant}/sub-{subject}/...

    \b
    MRI is the input T1 MR file name.
    OUTPUT_DIR is the BIDS output directory.
    """

    import traits.api as traits

    mri = [pathlib.Path(m).absolute() for m in mri]
    output_dir = (pathlib.Path(output_dir).absolute() / "derivatives" /
                  f"{pipeline}-{variant}").as_posix()
    if not subjects_atts:
        subjects_atts = [{'subject': m.name.split(".", 1)[0]} for m in mri]

    conf_options = []
    if "--config" not in capsul_args and "--studyconfig" not in capsul_args:
        conf_options = ["--config", "axon"]

    print('participants:', subjects_atts)
    print('mri:', mri)
    print('input_dir:', input_dir)
    print('output_dir:', output_dir)
    print('capsul:', capsul_args)
    print('morpho:', morpho_args)
    print('config options:', conf_options)

    conf_options += ['-o', output_dir]
    if input_dir:
        conf_options += ['-i', input_dir]

    iter_options = []
    if len(mri) > 1 or len(subjects_atts) > 1:
        iter_options = ["-I", "t1mri"]

    t1mri_args = []
    subjects_args = []
    if len(mri) != 0:
        mri = [m.as_posix() for m in mri]
        t1mri_args = [f"t1mri={(mri if len(iter_options) > 1 else mri[0])}"]
    if len(subjects_atts) != 0:
        atts = {}
        for s, sub in enumerate(subjects_atts):
            for att, val in sub.items():
                attval = atts.setdefault(att, [])
                while len(attval) < s:
                    attval.append(traits.Undefined)
                attval.append(val)
        for att, attval in atts.items():
            while len(attval) < len(subjects_atts):
                attval.append(traits.Undefined)
        # print('atts:', atts)
        if len(iter_options) != 0:
            for att, val in atts.items():
                subjects_args += ["-a", f"{att}={repr(val)}"]
        else:
            for att, val in atts.items():
                subjects_args += ["-a", f"{att}={val[0]}"]
    # print('subjects_args:', subjects_args)

    # if iterations are involved, disable any in-process multithreading
    # in order to contain the CPU usage, unless it is forced in user-specified
    # morpho_args.
    if iter_options and len([x for x in morpho_args
                             if x.startswith("allow_multithreading=")]) == 0:
        t1mri_args.append("allow_multithreading=False")

    capsul_cmd = [sys.executable, "-m", "capsul"] \
        + conf_options \
        + ['--opengl', '--if', input_fom,
           '--of', 'morpho-deepsulci-bids-2.0'] \
        + iter_options + subjects_args + capsul_args \
        + ["morphologist.capsul.morphologist"] + t1mri_args + morpho_args

    print(capsul_cmd)
    if not dry_run:
        subprocess.check_call(capsul_cmd)


    #engine = capsul_engine()
    #engine.load_modules(["fom", "axon", "spm"])
    #with engine.settings as session:
        #config = session.config("fom", "global")
        #config.input_fom = "morphologist-bids-2.0"
        #config.output_fom = "morphologist-bids-2.0"
        #config.input_directory = f"{output_dir}/derivatives/{pipeline}-{variant}"
        #config.output_directory = f"{output_dir}/derivatives/{pipeline}-{variant}"
    #process = engine.get_process_instance("morphologist.capsul.morphologist")
    #compl_engine = ProcessCompletionEngine.get_completion_engine(process)
    #attributes = compl_engine.get_attribute_values()
    #attributes.subject = subject
    #compl_engine.complete_parameters()
    #process.t1mri = str(mri)

    #process()


def parse_inputs(mris, output_dir, attributes=None, fom=None):
    input_directory = None
    if len(mris) == 0:
        input_directory = output_dir
    elif len(mris) == 1 and osp.isdir(mris[0]):
        input_directory = mris[0]
    if input_directory:
        return parse_bids_input_dir(input_directory, attributes, fom=fom)

    input_directory = osp.dirname(mris[0])
    engine = capsul_engine()
    engine.load_modules(['fom'])
    if fom is None:
        fom = 'morphologist-bids-2.0'
    # print('fom:', fom)
    with engine.settings as session:
        config = session.config('fom', 'global')
        config.input_fom = fom
        config.input_directory = input_directory

    sel_dict = {'files_list': mris}

    if attributes:
        if len(attributes) != len(mris):
            raise ValueError('attributes and mri lists sizes do not match')
        sel_dict = {
            'type': 'metadata',
            'upstream_selector': sel_dict,
            'metadata': attributes,
        }

    sel = data_selector.get_data_selector(
        database=input_directory,
        engine=engine,
        data_types=['morphologist.capsul.import_t1_mri.ImportT1Mri.input'],
        **sel_dict
    )
    data = sel.get_data()
    return input_directory, data


def parse_bids_input_dir(input_directory, attributes=None, fom=None):
    engine = capsul_engine()
    engine.load_modules(['fom'])
    if osp.exists(osp.join(input_directory, 'sourcedata', 'raw')):
        input_directory = osp.join(input_directory, 'sourcedata', 'raw')
    elif osp.exists(osp.join(input_directory, 'rawdata')):
        input_directory = osp.join(input_directory, 'rawdata')
    if fom is None:
        fom = 'raw-bids-1.0'

    dbfile = osp.join(
        input_directory,
        f'capsul-{cinfo.version_major}.{cinfo.version_minor}.sqlite')
    if osp.exists(dbfile):
        foms = [None]
    else:
        dbfile = None
        foms = [fom] + [x for x in ('raw-bids-1.0', 'morphologist-bids-2.0',
                                    'morphologist-auto-1.0',
                                    'morphologist-bids-1.0')
                        if x != fom]

    for fom in foms:
        with engine.settings as session:
            config = session.config('fom', 'global')
            config.input_fom = fom
            config.input_directory = input_directory

        if fom == 'raw-bids-1.0':
            sel_dict = {
                'upstream_selector': {'type': 'exhaustive'},
                'data_types':
                    ['morphologist.capsul.import_t1_mri.ImportT1Mri.input']
            }
        else:
            sel_dict = {
                'data_types':
                    ['morphologist.capsul.morphologist.Morphologist.'
                     'imported_t1mri']
            }
            if dbfile is not None:
                sel_dict['database_sqlite'] = dbfile
        if attributes:
            afilt = {}
            for att in attributes:
                for k, v in att.items():
                    if k not in afilt:
                        afilt[k] = v
                    if v not in afilt[k].split('|'):
                        afilt[k] = f'{afilt[k]}|{v}'
            sel_dict['data_filters'] = {'.*': afilt}
        # print(fom, ': sel_dict:', sel_dict)
        sel = data_selector.get_data_selector(
            database=input_directory,
            engine=engine,
            **sel_dict
        )
        # print('input_directory:', input_directory)
        # print('sel bids:', sel)
        # print('filter:', sel.data_filters)
        data = sel.get_data()
        if len(data[0][1]) != 0:
            print('found input data using FOM', sel.fom)
            return input_directory, data

    print('no input data found...')
    return input_directory, data  # empty if we get here...


description = f"""Process one or several T1 MR image(s) with
BrainVISA/Morphologist pipeline and put the result in an output directory using
the following BIDS organization:


{{output_dir}}/derivatives/morphologist-{morphologist_version}/sub-{{subject}}/...

There are actually three ways to specify inputs:

- either as independent MRI file names
- or as a BIDS raw data input directory. If only one input is given, and if   participants labels are provided, and if the input is a directory, then it is   interpreted as a raw input data directory, organized in BIDS layout.
- if no mri or input_directory arguments are given, assume input_directory=output_directory: subjects are taken from the same data directory as the output one, in a raw data subdirectory (sourcedata/raw/).

In addition to this commandline options, other options may be passed to the CAPSUL general commandline which is run under the hood. See "python -m capsul -h" for help about them.
Such options are separated by a "--". Ex:

morphologist-cli input_dir output_dir -s subject01 subject02 subject03 -- --swf

in this example, --swf specifies the use of Soma-Workflow to distribute processing across the cores of the local machine (which is recommended).

Running part of the pipeline:

Morphologist defines steps that can be enabled or disabled. The capsul commandline now has an easy syntax to specify them. Ex:

morphologist-cli input_dir output_dir -s subject01 subject02 subject03 -- pipeline_steps="brain_extraction, head_mesh-, sulci_labelling=False"

will do brain_extraction, then all steps from head_mesh, except sulci_labelling which is disabled.

The list (ordered) of supported steps are:
    importation, orientation, bias_correction, histogram_analysis,
    brain_extraction, renormalization, hemispheres_split, head_mesh,
    grey_white_segmentation, white_mesh, pial_mesh, sulci, sulci_labelling,
    sulcal_morphometry.
"""


class MultilineFormatter(argparse.HelpFormatter):
    def _fill_text(self, text, width, indent):
        text = text.replace('\n* ', '|n * ')
        text = text.replace('\n', '|n')
        text = self._whitespace_matcher.sub(' ', text).strip()
        paragraphs = text.split('|n')
        multiline_text = ''
        for paragraph in paragraphs:
            formatted_paragraph = textwrap.fill(
                paragraph, width, initial_indent=indent,
                subsequent_indent=indent) + '\n'
            multiline_text = multiline_text + formatted_paragraph
        return multiline_text


parser = argparse.ArgumentParser(
    description=description, formatter_class=MultilineFormatter
)
parser.add_argument(
    "--subject", "--participant_label", "-s", default=[], nargs='*',
    help="The label(s) of the participant(s) that should be analyzed. The "
    "label corresponds to sub-<participant_label> from the BIDS spec (so it "
    "does not include \"sub-\"). If this parameter is not provided all "
    "subjects should be analyzed. Multiple participants can be specified with "
    "a space separated list. If not specified, and if mri arguments are "
    "given, participants names will be created according to mri file names.")
parser.add_argument(
    '-a', '--attribute', default=[], nargs='*',
    help='Attributes associated with input data. Given in the shape '
    '"attribute=value", or "attribute=value1,value2..." for lists. If the mri '
    'arguments is a list of MRI files, then attributes will be assigned to '
    'each of the MRI files. If mri is a directory, then attributes will be '
    'used as a filter to select parsed metadata.\n'
    'Be careful that attributes values are considered to be regular '
    'expressions: this means they can include regex patterns, and if you '
    'intend an exact match, then you have to use "^" at values beginings and '
    '"$" at ends, like: -a subject=^charles-axel$,^louis-.+$. '
    'Attrinutes keys are not regular expressions.\n'
    'The -s parameter is just a shorthand for -a subject=^<something>$.')
parser.add_argument(
    "--dry-run", action="store_true",
    help="don't actually run Morphologist, just print the commandline which "
    "should be started.")

parser.add_argument(
    "mri", default=[], nargs="*",
    help="Either the directory with the input dataset formatted according to "
    "the BIDS standard, or a list of T1 MRI image files to be imported.")
parser.add_argument(
    "output_dir",
    help="The directory where the output files should be stored.")

argv = sys.argv[1:]
capsul_args = []
morpho_args = []

if "--" in argv:
    i = len(argv) - 1 - argv[::-1].index("--")
    capsul_args = argv[i + 1:]
    argv = argv[:i]
    # args with shape "param=value" are passed after the process
    capsul_flags = set([
        '-a', '--attribute', '-r', '--resource', '-p', '--password', '-w',
        '--write-workflow', '--rsa-pass', '--queue'])
    for i in range(len(capsul_args) - 1, -1, -1):
        p = capsul_args[i]
        if '=' not in p or p.startswith('-'):
            break
        prev = None
        if i > 0:
            prev = capsul_args[i - 1]
        if prev in capsul_flags:
            break
        morpho_args.append(p)
        del capsul_args[i]

args = parser.parse_args(argv)

mris = args.mri
subjects = args.subject
attributes = [{'subject': f'^{s}$'} for s in subjects]
for attd in args.attribute:
    attn, attv = attd.split('=', 1)
    attn = attn.strip()
    attvl = [x.strip() for x in attv.split(',')]
    if len(attributes) == 0:
        attributes = [{attn: v} for v in attvl]
    else:
        if len(attvl) == 1:
            v = attvl[0]
            for an in attributes:
                an[attn] = v
        else:
            for i, an in enumerate(attributes):
                an[attn] = attvl[i if i < len(attvl) else -1]
            for i in range(len(attributes), len(attvl)):
                attributes.append(dict(attributes[-1]))
                attributes[-1][attn] = attvl[i]

input_fom = None
for flag in ('--if', '--input-fom'):
    if flag in capsul_args:
        i = capsul_args.index(flag)
        input_fom = capsul_args[i + 1]

input_dir, input_data = parse_inputs(mris, args.output_dir, attributes,
                                     fom=input_fom)
# print('inputs:')
# print(input_data)
if len(input_data[0][1]) == 0:
    print('Nothing to do.')
    sys.exit(0)

suppressed = {'fom_name', 'fom_process', 'fom_parameter', 'fom_directory',
              'fom_format'}
mris = [item['path'] for item in input_data[0][1]]
attributes = [{k: v for k, v in item['attributes'].items()
               if k not in suppressed}
              for item in input_data[0][1]]

if input_fom is None:
    input_fom = 'morphologist-bids-2.0'
morphologist(mri=mris, output_dir=args.output_dir, input_dir=input_dir,
             subjects_atts=attributes, capsul_args=capsul_args,
             morpho_args=morpho_args, dry_run=args.dry_run,
             input_fom=input_fom)
